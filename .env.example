# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Server-side Application Owner YouTube Data API v3 key.
# Used by /api/youtube/playlist to load public and unlisted YouTube playlists.
YOUTUBE_API_KEY=""

# GOOGLE_OAUTH_CLIENT_ID & GOOGLE_OAUTH_CLIENT_SECRET: Optional server-side Google OAuth credentials.
# Used only when a host authorizes Google/YouTube to load their private YouTube playlists.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Server-side Application Owner Spotify credentials.
# Used for public playlist metadata (Client Credentials) and private playlists (OAuth + PKCE).
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# GEMINI_API_KEY: Optional runtime key managed by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
